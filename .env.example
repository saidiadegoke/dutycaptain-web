# Where the DutyCaptain runtime is.
#
# BUILD-TIME, not runtime: NEXT_PUBLIC_* is inlined into the client bundle, so
# this must be set before `docker compose build` / before Dokploy builds the
# image. In Dokploy put it under Build Arguments, not Environment.
#
# Public by necessity — it ends up in the bundle. Nothing secret belongs here;
# the session token is what authenticates, and that is per-user.
NEXT_PUBLIC_API_URL=https://api.dutycaptain.com

# This site's own public address — canonical URLs, sitemap.xml and link
# previews are built from it. Build-time, like the one above.
NEXT_PUBLIC_SITE_URL=https://dutycaptain.com
# true = keep this build out of search engines (staging). Build-time.
NEXT_PUBLIC_NOINDEX=false

# The port the container listens on. Runtime, so Environment is fine.
PORT=9821
NODE_ENV=production
HOSTNAME=0.0.0.0
